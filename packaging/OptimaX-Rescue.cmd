@echo off
rem OptimaX by X44TO - emergency rollback launcher.
setlocal EnableExtensions DisableDelayedExpansion
set "NoDefaultCurrentDirectoryInExePath=1"
set "PATHEXT=.COM;.EXE;.BAT;.CMD"
chcp 65001 >nul
rem The real script is regenerated by OptimaX after every change: ProgramData\OptimaX\rescue\OptimaX-Rescue.cmd
rem It works without OptimaX itself, also from Safe Mode. Unattended: OptimaX-Rescue.cmd /last or /all
rem 7.1.1: no environment variables here. ProgramData (like any variable) can be redefined by the user for their
rem own account, and the rescue script runs as administrator. The real ProgramData folder is read from HKLM
rem (writable only by administrators); our own variables are cleared first, so nothing comes from the environment,
rem and programs are not looked up in the current folder (it may be the Desktop).
set "PD="
set "RS="
set "ERRORLEVEL="
for /f "tokens=3,*" %%A in ('reg query "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Shell Folders" /v "Common AppData" 2^>nul') do if /i "%%A"=="REG_SZ" set "PD=%%B"
if not defined PD set "PD=C:\ProgramData"
set "RS=%PD%\OptimaX\rescue\OptimaX-Rescue.cmd"
if not exist "%RS%" goto nothing
call "%RS%" %*
exit /b %ERRORLEVEL%

:nothing
echo.
echo  OptimaX — аварійний відкат / аварийный откат / emergency rollback
echo.
echo  Немає змін для відкату: OptimaX ще нічого не змінював на цьому ПК (або все вже повернуто).
echo  Нет изменений для отката: OptimaX ещё ничего не менял на этом ПК (или всё уже возвращено).
echo  Nothing to roll back: OptimaX has not changed anything on this PC (or everything is already restored).
echo.
if "%~1"=="" pause
exit /b 0
