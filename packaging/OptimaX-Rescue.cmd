@echo off
rem OptimaX by X44TO - emergency rollback launcher.
rem The real script is regenerated by OptimaX after every change: %ProgramData%\OptimaX\rescue\OptimaX-Rescue.cmd
rem It works without OptimaX itself, also from Safe Mode. Unattended: OptimaX-Rescue.cmd /last or /all
chcp 65001 >nul
setlocal
set "RS=%ProgramData%\OptimaX\rescue\OptimaX-Rescue.cmd"
if not exist "%RS%" goto nothing
call "%RS%" %*
exit /b %ERRORLEVEL%

:nothing
echo.
echo  OptimaX — аварійний відкат / аварийный откат / emergency rollback
echo.
echo  Немає змін для відкату: OptimaX ще нічого не змінював на цьому ПК (або все вже повернуто).
echo  Нет изменений для отката: OptimaX ещё ничего не менял на этом ПК (или всё уже возвращено).
echo  Nothing to roll back: OptimaX has not changed anything on this PC (or everything is already restored).
echo.
if "%~1"=="" pause
exit /b 0
