<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath, конфігурація артефакту «installer»: другий запит релізу (release.yml, job sign).
     Артефакт GitHub — zip з OptimaX-Setup-<версія>.exe, зібраним з уже підписаного OptimaX.exe. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="OptimaX-Setup-*.exe" product-name="OptimaX" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
